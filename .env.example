# Variables de Nido. Copia este archivo a .env (y lo privado a .env.local, que no se sube).
# Las EXPO_PUBLIC_* van dentro de la app; el resto solo las ven el ordenador, la CI o el builder
# de EAS. Con las que no existan todavía vacías, la app y los scripts se comportan como hoy:
# el botón no sale, el cobro dice «Incluida por ahora», la build no intenta firmar ni enviar.
# Cada una dice de qué paso de LANZAMIENTO.md sale.

# --- Supabase (obligatorias en toda build; LANZAMIENTO.md paso 8) ---------------------------
# URL del proyecto (https://<ref>.supabase.co).
EXPO_PUBLIC_SUPABASE_URL=
# Clave publicable (anon) del proyecto.
EXPO_PUBLIC_SUPABASE_KEY=

# --- Sentry (LANZAMIENTO.md paso 7; el DSN es público) ---------------------------------------
# DSN del proyecto brad-lopez-io/casa.
EXPO_PUBLIC_SENTRY_DSN=
# Entorno que informa Sentry: development, preview o production (los perfiles de eas.json lo fijan).
EXPO_PUBLIC_APP_ENV=
# Secreto del builder: sube los source maps; sin él Sentry enseña trazas minificadas.
SENTRY_AUTH_TOKEN=

# --- Entrar con Google (LANZAMIENTO.md paso 3) ------------------------------------------------
# 1 enseña el botón de Google (necesita el cliente web y, en iOS, los dos de abajo).
EXPO_PUBLIC_AUTH_GOOGLE=
# Cliente OAuth «web» de Google Cloud: el que Supabase valida y el que firma el id_token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Cliente OAuth «iOS» de Google Cloud (solo iOS).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Esquema de URL del cliente iOS (com.googleusercontent.apps.…); sin él el plugin se omite en iOS.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Archivos secretos de EAS (eas env:create --type file): google-services.json de Firebase para
# Android (FCM) y GoogleService-Info.plist para iOS.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=

# --- Entrar con Apple (LANZAMIENTO.md paso 4) -------------------------------------------------
# 1 enseña el botón de Apple (iOS nativo; Android por navegador con el Services ID en Supabase).
EXPO_PUBLIC_AUTH_APPLE=
# Secretos de Supabase (supabase secrets set), para revocar el token de Apple al borrar la cuenta
# (Edge Function revoke-apple): Team ID, Key ID y clave .p8 de Sign in with Apple, y el
# identificador del cliente (bundle id en iOS, Services ID en Android).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SERVICE_ID=

# --- Invitaciones con dominio (LANZAMIENTO.md pasos 1 y 5) ----------------------------------
# Solo el dominio (sin ruta) donde se sirve site/: activa los App Links y Universal Links.
# Vacío, la invitación lleva a bradlopez13.github.io/casa.
EXPO_PUBLIC_INVITE_HOST=
# Raíz de la web para los enlaces legales de la app; vacío, https://bradlopez13.github.io/casa.
EXPO_PUBLIC_SITE_URL=

# --- Cobro (LANZAMIENTO.md paso 6; apagado hasta que Brad lo encienda) ----------------------
# true ofrece pagar la licencia; cualquier otra cosa, «Incluida por ahora».
EXPO_PUBLIC_BILLING_ENABLED=false
# Importe mensual por casa tal como se enseña («2,99 €»); el precio real lo pone la tienda.
EXPO_PUBLIC_LICENSE_PRICE=
# Claves públicas de RevenueCat de cada app; sin ellas el SDK no se configura y comprar dice
# «no disponible».
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Secreto de Supabase: firma de los eventos que RevenueCat manda a billing-webhook.
BILLING_WEBHOOK_SECRET=

# --- Envío a las tiendas (LANZAMIENTO.md pasos 2, 4 y 7; solo eas submit y release.yml) -----
# Secreto del repositorio de GitHub: token de Expo para eas build y eas submit en release.yml.
EXPO_TOKEN=
# Archivo secreto de EAS: cuenta de servicio de Google Play con permiso de subir versiones.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# App Store Connect: id numérico de la app, Team ID de Apple y el Apple ID (correo) que envía.
ASC_APP_ID=
APPLE_ID=

# --- Solo para desarrollar --------------------------------------------------------------------
# 1 escribe en la consola el registro de la cola (nunca en production: build-env.js lo rechaza).
EXPO_PUBLIC_QUEUE_LOG=
