{
  "expo": {
    "name": "Nido",
    "slug": "casa",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "casa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.bradlopez13.casa",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E3B41",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bradlopez13.casa"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#2E3B41",
          "imageWidth": 160,
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#2E3B41"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2E3B41"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "casa",
          "organization": "brad-lopez-io"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2badcebc-e47c-4dac-8813-9f4e5bb6af45"
      }
    }
  }
}
